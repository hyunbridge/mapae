# 일반
DEBUG=false
SERVER_MODE=all
SHUTDOWN_DRAIN_SECONDS=5

# 저장소
# USE_IN_MEMORY_STORE=true이면 Redis를 사용하지 않습니다.
# false이면 REDIS_URL이 필수이며 운영 환경에서는 Redis 6.2 이상을 권장합니다.
USE_IN_MEMORY_STORE=false
REDIS_URL=redis://localhost:6379/0
REDIS_WAIT_REPLICAS=0
REDIS_WAIT_TIMEOUT_MS=1000

# SMTP 서버
SMTP_HOST=0.0.0.0
SMTP_PORT=2525
SMTP_MAX_CONNECTIONS=1024
SMS_INBOUND_ADDRESS=verify@example.com
DUMP_INBOUND=false

# HTTP 서버
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
HTTP_MAX_CONNECTIONS=1024
CORS_ALLOW_ORIGINS=["https://app.example.com"]

# 인증
AUTH_TTL_SECONDS=600
VERIFIED_TTL_SECONDS=300

# JWT
JWT_PRIVATE_KEY=""
JWT_KEY_ID=default
JWT_EXTRA_JWKS_KEYS=[]
JWT_ISSUER=https://example.com
JWT_TTL_SECONDS=3600
